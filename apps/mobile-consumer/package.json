{
  "name": "@routeride/mobile-consumer",
  "version": "0.1.0",
  "private": true,
  "description": "RouteRide Consumer mobile app (Expo SDK 58)",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "jest --passWithNoTests --coverage"
  },
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo-google-fonts/jetbrains-mono": "^0.4.1",
    "@expo-google-fonts/manrope": "^0.4.2",
    "@routeride/contracts": "workspace:*",
    "@routeride/ui": "workspace:*",
    "@tanstack/react-query": "^5.80.0",
    "expo": "~58.0.19",
    "expo-constants": "~58.0.13",
    "expo-font": "~58.0.10",
    "expo-linking": "~58.0.14",
    "expo-router": "~58.0.26",
    "expo-secure-store": "~58.0.2",
    "expo-splash-screen": "~58.0.11",
    "expo-status-bar": "~58.0.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-maps": "1.29.11",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@react-native/jest-preset": "0.88.0",
    "@react-native/assets-registry": "0.88.0",
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^12.5.0",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.3.0",
    "babel-preset-expo": "~58.0.20",
    "eslint": "^9.21.0",
    "jest": "^30.5.2",
    "jest-expo": "~58.0.12",
    "ts-jest": "^29.2.5",
    "typescript": "^6.0.3"
  },
  "jest": {
    "preset": "jest-expo",
    "testTimeout": 20000,
    "testRegex": ".*\\.test\\.tsx?$",
    "transformIgnorePatterns": [
      "node_modules/(?!.*(expo|@expo|react-native|@react-native|@routeride))"
    ],
    "coverageThreshold": {
      "global": {
        "lines": 70,
        "branches": 65
      }
    }
  }
}
