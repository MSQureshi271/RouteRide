{
  "name": "@routeride/worker",
  "version": "0.1.0",
  "private": true,
  "description": "RouteRide notification worker — BullMQ consumer for FCM, email, and SMS delivery",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "start:dev": "ts-node -r tsconfig-paths/register src/main.ts",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "jest --passWithNoTests --coverage"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@routeride/config": "workspace:*",
    "@routeride/contracts": "workspace:*",
    "@sendgrid/mail": "^8.1.0",
    "bullmq": "^5.0.0",
    "firebase-admin": "^13.0.0",
    "ioredis": "^5.6.0",
    "pg": "^8.13.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.0"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.10",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testRegex": ".*\\.test\\.ts$",
    "coverageThreshold": {
      "global": {
        "lines": 70,
        "branches": 65
      }
    }
  }
}
