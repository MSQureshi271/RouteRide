{
  "name": "@routeride/mobile-driver",
  "version": "0.1.0",
  "private": true,
  "description": "RouteRide Driver mobile app (Expo SDK 53) — includes background location + foreground service",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "jest --passWithNoTests --coverage"
  },
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo-google-fonts/jetbrains-mono": "^0.4.1",
    "@expo-google-fonts/manrope": "^0.4.2",
    "@routeride/contracts": "workspace:*",
    "@routeride/ui": "workspace:*",
    "@tanstack/react-query": "^5.80.0",
    "expo": "~57.0.0",
    "expo-background-fetch": "~57.0.15",
    "expo-constants": "~57.0.17",
    "expo-document-picker": "^57.0.1",
    "expo-file-system": "~57.0.6",
    "expo-font": "~57.0.3",
    "expo-linking": "~57.0.9",
    "expo-router": "~57.0.18",
    "expo-secure-store": "~57.0.3",
    "expo-splash-screen": "~57.0.8",
    "expo-status-bar": "~57.0.1",
    "expo-task-manager": "~57.0.15",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-maps": "^1.29.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.2"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@react-native/assets-registry": "0.86.3",
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^12.5.0",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.18",
    "babel-preset-expo": "~57.0.10",
    "eslint": "^9.21.0",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.0",
    "ts-jest": "^29.2.5",
    "typescript": "^6.0.3"
  },
  "jest": {
    "preset": "jest-expo",
    "testRegex": ".*\\.test\\.tsx?$",
    "transformIgnorePatterns": [
      "node_modules/(?!(\\.pnpm|((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@routeride/.*))"
    ],
    "coverageThreshold": {
      "global": {
        "lines": 70,
        "branches": 65
      }
    }
  }
}
