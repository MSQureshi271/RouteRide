{
  "name": "@routeride/api",
  "version": "0.1.0",
  "private": true,
  "description": "RouteRide REST API and WebSocket server (NestJS + Fastify adapter)",
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "jest --passWithNoTests --coverage",
    "test:integration": "jest --config jest.integration.config.js --passWithNoTests --coverage",
    "prisma:emit": "prisma contract emit",
    "prisma:migrate": "prisma db migrate",
    "prisma:plan": "prisma migration plan",
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@fastify/helmet": "^13.1.1",
    "@nest-lab/throttler-storage-redis": "^1.2.0",
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-fastify": "^11.0.0",
    "@nestjs/terminus": "^11.0.0",
    "@nestjs/throttler": "^6.4.0",
    "@prisma/orm-extension-postgis": "8.0.0-rc.8",
    "@prisma/orm-postgres": "8.0.0-rc.8",
    "@routeride/config": "workspace:*",
    "@routeride/contracts": "workspace:*",
    "fastify": "^5.2.1",
    "@sentry/nestjs": "^10.71.0",
    "@sentry/profiling-node": "^10.71.0",
    "@types/uuid": "^11.0.0",
    "ioredis": "^6.0.0",
    "nestjs-pino": "^4.6.1",
    "pino-http": "^11.0.0",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "uuid": "^14.0.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.13.5",
    "eslint": "^9.21.0",
    "jest": "^29.7.0",
    "prisma": "8.0.0-rc.12",
    "ts-jest": "^29.2.5",
    "typescript": "^5.7.3"
  }
}
