  {
    "id": "checkConstraint.subscriptions.ck_subs_requested_terms_deadline",
    "label": "Add check constraint \"ck_subs_requested_terms_deadline\" on \"subscriptions\"",
    "operationClass": "additive",
    "target": {
      "id": "postgres",
      "details": {
        "schema": "public",
        "objectType": "checkConstraint",
        "name": "ck_subs_requested_terms_deadline",
        "table": "subscriptions"
      }
    },
    "precheck": [
      {
        "description": "ensure constraint \"ck_subs_requested_terms_deadline\" does not exist",
        "sql": "SELECT NOT EXISTS (SELECT 1 AS \"one\" FROM \"pg_constraint\" AS \"c\" INNER JOIN \"pg_namespace\" AS \"n\" ON \"n\".\"oid\" = \"c\".\"connamespace\" WHERE (\"c\".\"conname\" = $1 AND \"n\".\"nspname\" = $2 AND \"c\".\"conrelid\" = to_regclass($3))) AS \"result\"",
        "params": [
          "ck_subs_requested_terms_deadline",
          "public",
          "\"public\".\"subscriptions\""
        ]
      }
    ],
    "execute": [
      {
        "description": "add check constraint \"ck_subs_requested_terms_deadline\"",
        "sql": "ALTER TABLE \"public\".\"subscriptions\" ADD CONSTRAINT \"ck_subs_requested_terms_deadline\" CHECK ((requested_terms IS NULL AND response_deadline IS NULL) OR (requested_terms IS NOT NULL AND jsonb_typeof(requested_terms) = 'object' AND response_deadline IS NOT NULL))"
      }
    ],
    "postcheck": [
      {
        "description": "verify constraint \"ck_subs_requested_terms_deadline\" exists",
        "sql": "SELECT EXISTS (SELECT 1 AS \"one\" FROM \"pg_constraint\" AS \"c\" INNER JOIN \"pg_namespace\" AS \"n\" ON \"n\".\"oid\" = \"c\".\"connamespace\" WHERE (\"c\".\"conname\" = $1 AND \"n\".\"nspname\" = $2 AND \"c\".\"conrelid\" = to_regclass($3))) AS \"result\"",
        "params": [
          "ck_subs_requested_terms_deadline",
          "public",
          "\"public\".\"subscriptions\""
        ]
      }
    ]
  },
