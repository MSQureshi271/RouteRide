// Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬ Support Tickets Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬

model SupportTicket {
  id         String    @id @default(uuid())
  userId     String    @map("user_id")
  tripId     String?   @map("trip_id")
  status     String    @default("OPEN")
  subject    String
  body       String
  createdAt  DateTime  @default(now()) @map("created_at")
  resolvedAt DateTime? @map("resolved_at")

  @@map("support_tickets")
}

// ADR-011: declared availability and committed recurring runs.
model DriverAvailability {
  id String @id @default(uuid())
  driverProfileId String @map("driver_profile_id")
  operatingDay SmallInt @map("operating_day")
  windowStart Time @map("window_start")
  windowEnd Time @map("window_end")
  driverProfile DriverProfile @relation(fields: [driverProfileId], references: [id], onDelete: Cascade)
  @@index([driverProfileId, operatingDay, windowStart, windowEnd], map: "idx_driver_availability_day_window")
  @@map("driver_availability")
}

model RecurringRun {
  id String @id @default(uuid())
  driverProfileId String @map("driver_profile_id")
  operatingDay SmallInt @map("operating_day")
  legType pg.enum(ScheduleLegType) @map("leg_type")
  startsAt Time? @map("starts_at")
  endsAt Time? @map("ends_at")
  effectiveFrom Date @map("effective_from")
  effectiveTo Date? @map("effective_to")
  seatCapacity Int @map("seat_capacity")
  version Int @default(0)
  needsReview Boolean @default(false) @map("needs_review")
  driverProfile DriverProfile @relation(fields: [driverProfileId], references: [id])
  assignments RunAssignment[]
  @@index([driverProfileId, operatingDay, legType], map: "idx_runs_driver_day_leg")
  @@map("recurring_runs")
}

model RunAssignment {
  id String @id @default(uuid())
  runId String @map("run_id")
  subscriptionId String @map("subscription_id")
  driverProfileId String @map("driver_profile_id")
  legType pg.enum(ScheduleLegType) @map("leg_type")
  effectiveFrom Date @map("effective_from")
  effectiveTo Date? @map("effective_to")
  needsReview Boolean @default(false) @map("needs_review")
  run RecurringRun @relation(fields: [runId], references: [id])
  subscription Subscription @relation(fields: [subscriptionId], references: [id])
  stops RunStop[]
  @@unique([runId, subscriptionId], map: "uq_run_subscription")
  @@index([subscriptionId, legType], map: "idx_assignment_subscription_leg")
  @@map("run_assignments")
}

model RunStop {
  id String @id @default(uuid())
  assignmentId String @map("assignment_id")
  runId String @map("run_id")
  stopType RunStopType @map("stop_type")
  position Int
  location Geometry4326 @map("location")
  windowStart Time @map("window_start")
  windowEnd Time @map("window_end")
  assignment RunAssignment @relation(fields: [assignmentId], references: [id])
  @@unique([runId, position], map: "uq_run_stop_position")
  @@unique([assignmentId, stopType], map: "uq_assignment_stop_type")
  @@map("run_stops")
}
