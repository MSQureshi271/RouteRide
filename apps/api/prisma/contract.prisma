// Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬ Riders Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬

model Rider {
  id                String    @id @default(uuid())
  consumerProfileId String    @map("consumer_profile_id")
  name              String
  photoUrl          String?   @map("photo_url")
  homeAddressText   String    @map("home_address_text")
  homeLocation      Geometry4326? @map("home_location")
  destAddressText   String    @map("dest_address_text")
  destLocation      Geometry4326? @map("dest_location")
  notes             String?
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @default(now()) @map("updated_at")

  // Relations
  consumerProfile ConsumerProfile @relation(fields: [consumerProfileId], references: [id], onDelete: Cascade)
  subscriptions   Subscription[]

  @@index(expression: "(home_location::geography)", map: "idx_riders_home", type: "gist")
  @@index(expression: "(dest_location::geography)", map: "idx_riders_dest", type: "gist")
  @@map("riders")
}

// Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬ Subscriptions Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬

model Subscription {
  id                    String    @id @default(uuid())
  riderId               String    @map("rider_id")
  driverProfileId       String    @map("driver_profile_id")
  type                  SubType
  agreedPickupTime      DateTime?  @map("agreed_pickup_time")
  agreedDropoffTime     DateTime?  @map("agreed_dropoff_time")
  agreedPickupLocation  Geometry4326? @map("agreed_pickup_location")
  agreedDropoffLocation Geometry4326? @map("agreed_dropoff_location")
  pickupAddressText     String?    @map("pickup_address_text")
  dropoffAddressText    String?    @map("dropoff_address_text")
  monthlyPriceCents     Int       @map("monthly_price_cents")
  currency              String    @default("PKR") @map("currency")
  status                SubStatus @default(PENDING)
  startDate             DateTime  @map("start_date")
  nextBillingDate       DateTime?  @map("next_billing_date")
  stripeSubscriptionId  String?   @map("stripe_subscription_id")
  cancellationReason    String?   @map("cancellation_reason")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @default(now()) @map("updated_at")

  requestedTerms        Jsonb? @map("requested_terms")
  responseDeadline      DateTime? @map("response_deadline")

  // Relations
  rider         Rider         @relation(fields: [riderId], references: [id])
  driverProfile DriverProfile @relation(fields: [driverProfileId], references: [id])
  scheduleSlots DriverScheduleSlot[]
  runAssignments RunAssignment[]
  trips         Trip[]
  payments      Payment[]
  reviews       Review[]
  messages      Message[]

  @@index([driverProfileId, status], map: "idx_subs_driver_status")
  @@index([riderId], map: "idx_subs_rider")
  @@index([status, responseDeadline], map: "idx_subs_response_deadline")
  @@index([riderId, driverProfileId, status], map: "idx_subs_rider_driver_status")
  @@map("subscriptions")
}

