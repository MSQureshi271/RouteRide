// Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬ Users Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬

model User {
  id                String      @id @default(uuid())
  email             String?
  phone             String
  passwordHash      String?     @map("password_hash")
  role              UserRole    @default(CONSUMER)
  status            UserStatus  @default(PENDING_VERIFICATION)
  fullName          String      @map("full_name")
  profilePhotoUrl   String?     @map("profile_photo_url")
  fcmToken          String?     @map("fcm_token")
  preferredLanguage String      @default("en") @map("preferred_language")
  createdAt         DateTime    @default(now()) @map("created_at")
  updatedAt         DateTime    @default(now()) @map("updated_at")
  deletedAt         DateTime?   @map("deleted_at")

  // Relations
  driverProfile    DriverProfile?
  consumerProfile  ConsumerProfile?
  sentMessages     Message[]        @relation("MessageSender")
  authoredReviews  Review[]         @relation("ReviewAuthor")
  receivedReviews  Review[]         @relation("ReviewTarget")
  notifications    Notification[]
  auditActorLog    AuditLog[]       @relation("AuditActor")
  documentVerifier DriverDocument[] @relation("DocumentVerifier")

  @@index([phone], map: "idx_users_phone", unique: true)
  @@index([email], map: "idx_users_email", unique: true)
  @@map("users")
}

// Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬ Driver Profiles Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬

model DriverProfile {
  id                   String       @id @default(uuid())
  userId               String       @unique @map("user_id")
  licenceNumber        String       @map("licence_number")
  vehicleMake          String       @map("vehicle_make")
  vehicleModel         String       @map("vehicle_model")
  vehicleYear          Int          @map("vehicle_year")
  vehicleColour        String       @map("vehicle_colour")
  plateNumber          String       @unique @map("plate_number")
  seatCapacity         Int          @map("seat_capacity")
  routePolyline        Geometry4326? @map("route_polyline")
  routeState           DriverRouteState @default(UNSET) @map("route_state")
  serviceArea          Geometry4326? @map("service_area")
  operatingCity        String? @map("operating_city")
  startingLocation     Geometry4326? @map("starting_location")
  acceptingRequests    Boolean @default(false) @map("accepting_requests")
  coverageSetupRequired Boolean @default(true) @map("coverage_setup_required")
  availabilityVersion Int @default(0) @map("availability_version")
  rosterVersion        Int @default(0) @map("roster_version")
  operatingDays        Int[]        @map("operating_days")
  basePriceCents       Int          @map("base_price_cents")
  currency             String       @default("PKR") @map("currency")
  status               DriverStatus @default(PENDING)
  verificationTier     VerifyTier   @default(BASIC) @map("verification_tier")
  stripeAccountId      String?      @map("stripe_account_id")
  bankAccountRef       String?      @map("bank_account_ref")
  acceptanceRate       Decimal?     @map("acceptance_rate")
  acceptedRequestCount Int          @default(0) @map("accepted_request_count")
  eligibleRequestCount Int          @default(0) @map("eligible_request_count")
  typicalDepartureTime DateTime?    @map("typical_departure_time")
  createdAt            DateTime     @default(now()) @map("created_at")
  updatedAt            DateTime     @default(now()) @map("updated_at")

  // Relations
  user            User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  documents       DriverDocument[]
  scheduleSlots   DriverScheduleSlot[]
  trips           Trip[]               @relation("TripDriver")
  locationLogs    LocationLog[]
  payouts         DriverPayout[]
  subscriptions   Subscription[]
  matchingStats   DriverMatchingStats[]
  availability    DriverAvailability[]
  recurringRuns   RecurringRun[]

  @@index([status], map: "idx_dp_status")
  @@index([serviceArea], map: "idx_dp_service_area", type: "gist")
  @@index(expression: "(route_polyline::geography)", map: "idx_dp_route", type: "gist")
  @@map("driver_profiles")
}

// Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬ Driver Documents Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬

model DriverDocument {
  id          String    @id @default(uuid())
  driverId    String    @map("driver_id")
  docType     String    @map("doc_type")
  s3Key       String    @map("s3_key")
  expiryDate  DateTime? @map("expiry_date")
  verifiedAt  DateTime? @map("verified_at")
  verifiedBy  String?   @map("verified_by")
  createdAt   DateTime  @default(now()) @map("created_at")

  // Relations
  driver   DriverProfile @relation(fields: [driverId], references: [id], onDelete: Cascade)
