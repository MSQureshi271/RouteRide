#!/usr/bin/env sh
# pre-commit-secret-scan: abort if staged files contain known secret patterns.
# This is a lightweight first line of defence. For a full solution, add
# detect-secrets or gitleaks to the CI pipeline (T0.08).

PATTERNS='sk_live_|sk_test_|rk_live_|whsec_[A-Za-z0-9]{10,}|AKIA[0-9A-Z]{16}|-----BEGIN (RSA|EC|OPENSSH) PRIVATE KEY|password\s*=\s*["\x27][^"\x27]{8,}|secret\s*=\s*["\x27][^"\x27]{8,}'

STAGED=$(git diff --cached --name-only --diff-filter=ACMR 2>/dev/null)

if [ -n "$STAGED" ]; then
  MATCH=$(git diff --cached -- $STAGED 2>/dev/null | grep -E "$PATTERNS" | grep -v "\.env\.example" | head -3)
  if [ -n "$MATCH" ]; then
    echo ""
    echo "🚨  COMMIT BLOCKED — potential secret detected in staged changes:"
    echo ""
    echo "$MATCH" | head -5
    echo ""
    echo "If this is a false positive, use: git commit --no-verify (with team approval)."
    echo "Never commit real keys to version control. Rotate the key if it was already exposed."
    exit 1
  fi
fi
