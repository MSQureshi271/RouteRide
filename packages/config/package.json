{
  "name": "@routeride/config",
  "version": "0.1.0",
  "private": true,
  "description": "Shared configuration: Zod-validated env loader, Pino logger, OTel tracing initialiser",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    },
    "./logger": {
      "import": "./dist/logger.js",
      "require": "./dist/logger.cjs",
      "types": "./dist/logger.d.ts"
    },
    "./tracing": {
      "import": "./dist/tracing.js",
      "require": "./dist/tracing.cjs",
      "types": "./dist/tracing.d.ts"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts src/logger.ts src/tracing.ts --format esm,cjs --dts",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "jest --passWithNoTests --coverage"
  },
  "dependencies": {
    "pino": "^9.7.0",
    "zod": "^3.25.74"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^22.13.5",
    "eslint": "^9.21.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "tsup": "^8.4.0",
    "typescript": "^5.7.3"
  }
}
