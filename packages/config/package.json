{
  "name": "@routeride/config",
  "version": "0.1.0",
  "private": true,
  "description": "Shared configuration: Zod-validated env loader, Pino logger, OTel tracing initialiser",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./logger": {
      "types": "./dist/logger.d.ts",
      "import": "./dist/logger.mjs",
      "require": "./dist/logger.js"
    },
    "./tracing": {
      "types": "./dist/tracing.d.ts",
      "import": "./dist/tracing.mjs",
      "require": "./dist/tracing.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts src/logger.ts src/tracing.ts --format esm,cjs --dts",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "jest --passWithNoTests --coverage"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.79.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.221.0",
    "@opentelemetry/sdk-node": "^0.221.0",
    "dotenv": "^17.4.2",
    "nestjs-pino": "^4.6.1",
    "pino": "^9.7.0",
    "pino-http": "^11.0.0",
    "zod": "^3.25.74"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^22.13.5",
    "eslint": "^9.21.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "tsup": "^8.4.0",
    "typescript": "^5.7.3"
  }
}
