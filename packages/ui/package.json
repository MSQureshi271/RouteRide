{
  "name": "@routeride/ui",
  "version": "0.1.0",
  "private": true,
  "description": "Shared UI component library for RouteRide mobile apps (React Native / Expo)",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./components/TimeWheelPicker": "./src/components/TimeWheelPicker.tsx",
    "./*": "./src/*",
    "./api/*": "./src/api/*",
    "./store/*": "./src/store/*",
    "./forms/*": "./src/forms/*",
    "./components/*": "./src/components/*",
    "./notifications/*": "./src/notifications/*"
  },
  "scripts": {
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "jest --passWithNoTests --coverage"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@quidone/react-native-wheel-picker": "1.7.2",
    "@routeride/contracts": "workspace:*",
    "@tanstack/react-query": "^5.80.0",
    "axios": "^1.7.0",
    "i18next": "^23.16.0",
    "react-hook-form": "^7.54.0",
    "react-i18next": "^15.5.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/react": "~19.3.0",
    "axios-mock-adapter": "^2.1.0",
    "eslint": "^9.21.0",
    "jest": "^29.7.0",
    "react-native-maps": "1.29.11",
    "ts-jest": "^29.2.5",
    "typescript": "^5.7.3"
  },
  "peerDependencies": {
    "expo-secure-store": ">=14",
    "react": "^19.3.0",
    "react-native": "^0.88.0",
    "react-native-maps": "*"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testRegex": ".*\\.test\\.ts$",
    "coverageThreshold": {
      "global": {
        "lines": 70,
        "branches": 65
      }
    }
  }
}
