{
  "name": "@routeride/contracts",
  "version": "0.1.0",
  "private": true,
  "description": "Shared Zod schemas, TypeScript types, and OpenAPI document for all RouteRide services",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "jest --passWithNoTests --coverage"
  },
  "dependencies": {
    "zod": "^3.25.74"
  },
  "devDependencies": {}
}
