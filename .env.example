# ═══════════════════════════════════════════════════════════════════════════════
# RouteRide — Environment Variables Template
# ═══════════════════════════════════════════════════════════════════════════════
# Copy this file to .env and fill in real values for local development.
# .env is NEVER committed. .env.example IS committed (placeholder values only).
# In production, values come from AWS Secrets Manager / ECS task environment.
# ═══════════════════════════════════════════════════════════════════════════════

# ─── Application ─────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# ─── Database ────────────────────────────────────────────────────────────────
# PostgreSQL 16 + PostGIS 3.4
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL=postgresql://routeride:changeme@localhost:5432/routeride_dev

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── JWT ─────────────────────────────────────────────────────────────────────
# Access token TTL: 15 minutes (900 seconds).
# Refresh token TTL: 30 days (2592000 seconds).
# Minimum 64 random bytes for JWT_SECRET.
JWT_SECRET=REPLACE_WITH_64_RANDOM_BYTES_BASE64
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000

# ─── Stripe ──────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_REPLACE_ME
STRIPE_PUBLISHABLE_KEY=pk_test_REPLACE_ME
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME

# ─── AWS ─────────────────────────────────────────────────────────────────────
# In production, credentials come from the ECS task role — never set here.
# For local development with LocalStack:
AWS_REGION=ap-south-1
AWS_ENDPOINT_URL=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
S3_DOCUMENTS_BUCKET=routeride-documents-local

# ─── Firebase (FCM push notifications) ───────────────────────────────────────
# Path to the service account JSON file (local dev only).
# In production, value comes from AWS Secrets Manager as a JSON string.
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json

# ─── Matching Service ────────────────────────────────────────────────────────
MATCHING_SERVICE_URL=http://localhost:8000
MATCHING_SERVICE_TIMEOUT_MS=5000

# ─── CORS ────────────────────────────────────────────────────────────────────
# In production, must NOT be "*".
CORS_ALLOWED_ORIGINS=http://localhost:3001,http://localhost:8081

# ─── Rate Limiting ───────────────────────────────────────────────────────────
RATE_LIMIT_AUTH_MAX=5
RATE_LIMIT_AUTH_WINDOW_MS=600000
RATE_LIMIT_OTP_MAX=3
RATE_LIMIT_OTP_WINDOW_MS=300000
RATE_LIMIT_SEARCH_MAX=30
RATE_LIMIT_SEARCH_WINDOW_MS=60000

# ─── Platform Parameters (see docs/platform-parameters.md) ───────────────────
LAUNCH_CITY_NAME=Karachi
LAUNCH_CITY_TIMEZONE=Asia/Karachi
LAUNCH_CITY_BBOX_MIN_LAT=24.7000
LAUNCH_CITY_BBOX_MAX_LAT=25.1500
LAUNCH_CITY_BBOX_MIN_LON=66.8500
LAUNCH_CITY_BBOX_MAX_LON=67.3500
DEFAULT_CURRENCY=PKR
STRIPE_ACCOUNT_COUNTRY=PK
DRIVER_PRICE_MIN_CENTS=500000
DRIVER_PRICE_MAX_CENTS=3000000
REQUIRED_DRIVER_DOCUMENTS=cnic,license,vehicle_registration

# ─── Sentry ──────────────────────────────────────────────────────────────────
SENTRY_DSN=https://REPLACE_ME@sentry.io/REPLACE_ME

# ─── Google Maps ─────────────────────────────────────────────────────────────
GOOGLE_MAPS_API_KEY=REPLACE_ME
